set / interface ethernet-1/1 admin-state enable
set / interface ethernet-1/1 subinterface 0 ipv4 admin-state enable
set / interface ethernet-1/1 subinterface 0 ipv4 address 10.2.1.1/30
set / interface ethernet-1/2 admin-state enable
set / interface ethernet-1/2 subinterface 0 ipv4 admin-state enable
set / interface ethernet-1/2 subinterface 0 ipv4 address 10.2.2.1/30
set / interface ethernet-1/3 admin-state enable
set / interface ethernet-1/3 subinterface 0 ipv4 admin-state enable
set / interface ethernet-1/3 subinterface 0 ipv4 address 10.2.3.1/30
set / interface lo0 subinterface 0 ipv4 admin-state enable
set / interface lo0 subinterface 0 ipv4 address 10.100.0.1/32
set / network-instance default interface ethernet-1/1.0
set / network-instance default interface ethernet-1/2.0
set / network-instance default interface ethernet-1/3.0
set / network-instance default interface lo0.0
set / routing-policy prefix-set own-lo prefix 10.100.0.1/32 mask-length-range exact
set / routing-policy policy export-rr default-action policy-result reject
set / routing-policy policy export-rr statement lo match prefix prefix-set own-lo
set / routing-policy policy export-rr statement lo action policy-result accept
set / routing-policy policy export-rr statement bgp match protocol bgp
set / routing-policy policy export-rr statement bgp action policy-result accept
set / routing-policy policy accept-all default-action policy-result accept
set / network-instance default protocols bgp admin-state enable
set / network-instance default protocols bgp autonomous-system 65100
set / network-instance default protocols bgp router-id 10.100.0.1
set / network-instance default protocols bgp afi-safi ipv4-unicast admin-state enable
set / network-instance default protocols bgp group rr-clients peer-as 65100
set / network-instance default protocols bgp group rr-clients export-policy [ export-rr ]
set / network-instance default protocols bgp group rr-clients import-policy [ accept-all ]
set / network-instance default protocols bgp group rr-clients route-reflector client true
set / network-instance default protocols bgp group rr-clients route-reflector cluster-id 10.100.0.1
set / network-instance default protocols bgp neighbor 10.2.1.2 peer-group rr-clients
set / network-instance default protocols bgp neighbor 10.2.2.2 peer-group rr-clients
set / network-instance default protocols bgp neighbor 10.2.3.2 peer-group rr-clients
