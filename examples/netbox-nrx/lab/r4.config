frr defaults datacenter
hostname r4
!
interface eth1
 ip address 10.0.34.2/30
!
interface eth2
 ip address 10.0.14.2/30
!
interface lo
 ip address 192.168.4.1/24
!
router bgp 65004
 bgp router-id 192.168.4.1
 neighbor 10.0.34.1 remote-as 65003
 neighbor 10.0.14.1 remote-as 65001
 address-family ipv4 unicast
  network 192.168.4.0/24
  neighbor 10.0.34.1 route-map ALLOW-ALL in
  neighbor 10.0.34.1 route-map ALLOW-ALL out
  neighbor 10.0.14.1 route-map ALLOW-ALL in
  neighbor 10.0.14.1 route-map ALLOW-ALL out
 exit-address-family
!
route-map ALLOW-ALL permit 10
!