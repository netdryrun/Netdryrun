frr defaults datacenter
hostname r1
!
interface eth1
 ip address 10.0.12.1/30
!
interface eth2
 ip address 10.0.14.1/30
!
interface lo
 ip address 192.168.1.1/24
!
router bgp 65001
 bgp router-id 192.168.1.1
 neighbor 10.0.12.2 remote-as 65002
 neighbor 10.0.14.2 remote-as 65004
 address-family ipv4 unicast
  network 192.168.1.0/24
  neighbor 10.0.12.2 route-map ALLOW-ALL in
  neighbor 10.0.12.2 route-map ALLOW-ALL out
  neighbor 10.0.14.2 route-map ALLOW-ALL in
  neighbor 10.0.14.2 route-map ALLOW-ALL out
 exit-address-family
!
route-map ALLOW-ALL permit 10
!