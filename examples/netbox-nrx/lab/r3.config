frr defaults datacenter
hostname r3
!
interface eth1
 ip address 10.0.23.2/30
!
interface eth2
 ip address 10.0.34.1/30
!
interface lo
 ip address 192.168.3.1/24
!
router bgp 65003
 bgp router-id 192.168.3.1
 neighbor 10.0.23.1 remote-as 65002
 neighbor 10.0.34.2 remote-as 65004
 address-family ipv4 unicast
  network 192.168.3.0/24
  neighbor 10.0.23.1 route-map ALLOW-ALL in
  neighbor 10.0.23.1 route-map ALLOW-ALL out
  neighbor 10.0.34.2 route-map ALLOW-ALL in
  neighbor 10.0.34.2 route-map ALLOW-ALL out
 exit-address-family
!
route-map ALLOW-ALL permit 10
!