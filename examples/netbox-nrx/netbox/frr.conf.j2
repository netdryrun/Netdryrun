{#- NetBox config template: renders a router's FRR config from NetBox data.
    Interfaces and addresses come from the device, the ASN from its config
    context, and each BGP neighbor from the far end of a cable. -#}
frr defaults datacenter
hostname {{ device.name }}
!
{%- for iface in device.interfaces.all() %}
{%- for ip in iface.ip_addresses.all() %}
interface {{ iface.name }}
 ip address {{ ip.address }}
!
{%- endfor %}
{%- endfor %}
{%- set lo = device.interfaces.filter(name="lo").first() %}
{%- set lan = lo.ip_addresses.first().address if lo else none %}
router bgp {{ bgp.asn }}
{%- if lan %}
 bgp router-id {{ lan.ip }}
{%- endif %}
{%- set peers = [] %}
{%- for iface in device.interfaces.all() %}
{%- for peer in iface.link_peers %}
{%- set peer_ip = peer.ip_addresses.first() %}
{%- if peer_ip %}
{%- set _ = peers.append((peer_ip.address.ip, peer.device.local_context_data.bgp.asn)) %}
{%- endif %}
{%- endfor %}
{%- endfor %}
{%- for ip, asn in peers %}
 neighbor {{ ip }} remote-as {{ asn }}
{%- endfor %}
 address-family ipv4 unicast
{%- if lan %}
  network {{ lan.cidr }}
{%- endif %}
{%- for ip, asn in peers %}
  neighbor {{ ip }} route-map ALLOW-ALL in
  neighbor {{ ip }} route-map ALLOW-ALL out
{%- endfor %}
 exit-address-family
!
route-map ALLOW-ALL permit 10
!
